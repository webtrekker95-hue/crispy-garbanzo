# Copy to .env.local and fill in real values. Never commit .env.local.

DATABASE_URL="postgresql://user:password@localhost:5432/excellent_driving?schema=public"

NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

RESEND_API_KEY=""

# Optional: protects /api/cron/booking-reminders from being called by anyone
# who finds the URL. Vercel Cron sends this automatically as a Bearer token
# when set in the project's env vars — see vercel.json.
CRON_SECRET=""
